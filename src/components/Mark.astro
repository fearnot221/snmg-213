---
const { large = false } = Astro.props;
---
<span class:list={['brand-mark', { large }]} aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
<style>
  .brand-mark{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;width:31px;height:27px;flex-shrink:0;align-items:end}.brand-mark i{background:currentColor;height:100%;clip-path:polygon(0 0,100% 0,100% 75%,70% 75%,70% 100%,30% 100%,30% 75%,0 75%)}.brand-mark i:nth-child(2),.brand-mark i:nth-child(5){height:72%}.large{width:80px;height:72px;gap:6px}
</style>
