---
import { withBase } from '../lib/paths.mjs';
---
<div class="switch-art" aria-label="213 室服務交換器示意，可選擇網路服務">
  <div class="switch-top" aria-hidden="true"><span class="signal-slot"></span><span class="signal-slot"></span></div>
  <div class="room-number" aria-hidden="true">213</div>
  <div class="switch-ports">
    {[['網路', '/forms#network'], ['DNS', '/forms#dns'], ['郵件', '/forms#mail'], ['網頁', '/forms#hosting']].map(([name, href]) => <a href={withBase(href)} class="port"><span class="socket" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span>{name}</span></a>)}
  </div>
  <div class="switch-bottom"><span>點選連接埠，找到你的服務</span><span aria-hidden="true">↗</span></div>
</div>
<style>
  .switch-art{background:var(--accent);color:white;padding:28px 32px 22px;position:relative;clip-path:polygon(0 0,calc(100% - 48px) 0,100% 48px,100% 100%,0 100%);min-width:0;align-self:stretch;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.switch-top,.switch-bottom{display:flex;justify-content:space-between;gap:16px;font-size:14px}.switch-top{padding-right:20px}.signal-slot{width:38px;height:5px;background:#ffffff6b}.signal-slot:last-child{width:12px;background:#fff}.room-number{font-size:clamp(160px,24vw,350px);font-weight:800;line-height:.95;letter-spacing:-.08em;margin-left:-.035em;padding:14px 0 20px}.switch-ports{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.port{display:flex;flex-direction:column;align-items:center;gap:14px;padding:15px 7px 10px;background:#173fb8;transition:background-color .18s ease,transform .18s ease}.socket{width:100%;height:57px;background:var(--bg);clip-path:polygon(0 0,100% 0,100% 68%,76% 68%,76% 86%,65% 86%,65% 100%,35% 100%,35% 86%,24% 86%,24% 68%,0 68%);display:flex;justify-content:center;gap:4px;align-items:start;padding-top:7px}.socket i{width:4px;height:15px;background:var(--accent)}.port span:last-child{font-size:14px}.switch-bottom{margin-top:24px;color:#fff}.port:active{transform:scale(.96)}@media(hover:hover){.port:hover{background:#102c80;transform:translateY(-4px)}}@media(prefers-reduced-motion:no-preference){.switch-art{animation:shutter 1000ms cubic-bezier(.22,1,.36,1) both}.port{animation:port-in 800ms cubic-bezier(.22,1,.36,1) both}.port:nth-child(2){animation-delay:80ms}.port:nth-child(3){animation-delay:160ms}.port:nth-child(4){animation-delay:240ms}@keyframes shutter{from{opacity:.25;transform:translateX(35px)}to{opacity:1;transform:none}}@keyframes port-in{from{transform:translateY(25px);opacity:0}to{transform:none;opacity:1}}}@media(max-width:800px){.switch-art{padding:24px}.room-number{font-size:clamp(160px,45vw,290px);padding:12px 0}.socket{height:50px}.switch-top,.switch-bottom{font-size:13px}.switch-ports{gap:10px}}@media(max-width:420px){.socket{height:42px;gap:3px}.socket i{width:3px;height:12px}.switch-art{padding:22px 18px}.switch-top{padding-right:18px}}
</style>
<style>.switch-art{container-type:inline-size}.switch-art .room-number{font-size:64cqw}</style>
