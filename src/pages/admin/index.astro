---
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate } from '../../lib/content.mjs';
import { cmsUrl, repositoryUrl } from '../../lib/paths.mjs';
const posts = getPosts().slice(0, 5);
---
<Layout title="內容管理">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <header class="page-intro wrap"><h1>更新內容，<br />交給 GitHub。</h1><p>在瀏覽器編輯、儲存成 commit，再自動發布網站。內容有版本紀錄，也能透過 GitHub 回復。</p><div class="cms-actions"><a class="button" href={cmsUrl} target="_blank" rel="noopener noreferrer">開啟內容編輯器 <span aria-hidden="true">↗</span></a><a class="text-link" href={repositoryUrl} target="_blank" rel="noopener noreferrer">查看 GitHub repo ↗</a></div></header>
  <div class="page-content wrap">
    <div class="cms-grid"><section class="cms-panel"><h2>文章與公告</h2><p>新增文章、調整分類、草稿與置頂，使用圖文編輯器撰寫內容，也能上傳圖片。</p><a class="text-link" href={`${cmsUrl}/collection/posts`} target="_blank" rel="noopener noreferrer">管理文章與公告 ↗</a></section><section class="cms-panel"><h2>網站內容</h2><p>修改首頁、機房與培訓介紹、聯絡資訊，以及申請與異常回報連結。</p><a class="text-link" href={`${cmsUrl}/file/site`} target="_blank" rel="noopener noreferrer">編輯網站內容 ↗</a></section></div>
    <section class="cms-instructions"><h2>第一次使用</h2><ol><li>開啟 Pages CMS，選擇使用 GitHub 登入。</li><li>安裝 Pages CMS GitHub App，選擇只授權 <strong>snmg-213</strong> repo。</li><li>選擇 <strong>fearnot221 / snmg-213 / main</strong>，即可編輯文章與網站內容。</li><li>儲存後產生 commit；等待 GitHub Actions 成功，前台就會更新。</li></ol><p>這裡是管理入口，實際編輯權限由 GitHub 控制。你不需要架設後台伺服器，也不需要網站管理員密碼。</p><a class="text-link" href={`${repositoryUrl}/actions`} target="_blank" rel="noopener noreferrer">查看部署進度 ↗</a></section>
    <section class="cms-recent"><div class="section-heading"><h2>目前公開內容</h2><a class="text-link" href={`${repositoryUrl}/tree/main/src/content/posts`} target="_blank" rel="noopener noreferrer">直接在 GitHub 編輯 ↗</a></div><div class="article-list">{posts.map(post => <a class="article-item" href={`${repositoryUrl}/edit/main/src/content/posts/${encodeURIComponent(post.file)}`} target="_blank" rel="noopener noreferrer"><div class="news-meta"><span>{post.category}</span><span>{formatDate(post.date)}</span></div><div><h3>{post.title}</h3><p>在 GitHub 開啟內容檔案</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
  </div>
</Layout>
<style>.cms-actions{display:flex;gap:28px;align-items:center;flex-wrap:wrap;margin-top:35px}.cms-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.cms-panel{background:white;padding:40px}.cms-panel h2{font-size:30px;margin-bottom:20px}.cms-panel p{max-width:420px;margin-bottom:25px}.cms-instructions{background:var(--surface);padding:40px;margin-block:35px 80px}.cms-instructions h2{font-size:30px}.cms-instructions ol{padding-left:24px;line-height:2.3;margin-block:25px}.cms-instructions p{max-width:780px;margin-bottom:15px}.cms-recent .section-heading h2{font-size:36px}@media(max-width:600px){.cms-grid{grid-template-columns:1fr}.cms-panel,.cms-instructions{padding:28px}.cms-panel h2,.cms-instructions h2{font-size:27px}.cms-recent .section-heading{flex-direction:column;gap:10px}.cms-recent .section-heading h2{font-size:30px}}</style>
