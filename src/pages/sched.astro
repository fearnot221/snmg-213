---
import Layout from '../layouts/Layout.astro';
import { getSettings, getSchedule } from '../lib/content.mjs';
import { withBase } from '../lib/paths.mjs';
const s=getSettings();const schedule=getSchedule();
const days=['星期一','星期二','星期三','星期四','星期五'];
---
<Layout title="機房值班表"><header class="page-intro wrap"><a class="back-link" href={withBase('/')}>首頁</a><h1>機房值班表</h1><p>{s.officeHours} · {s.phone}<br />班表更新於 {schedule.updated}，實際值班可能依課程與學期調整。</p></header><div class="page-content wrap"><div class="schedule-desktop"><table class="duty-table"><caption>工程二館網路機房值班表</caption><thead><tr><th scope="col">時間</th>{days.map((day,i)=><th scope="col" data-day-col={i+1}>{day}</th>)}</tr></thead><tbody>{schedule.rows.map((row:any[])=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell.text}</th>:<td data-day-col={i}>{cell.members.length?cell.members.map((person:any)=><a href={withBase(person.href)}>{person.name}</a>):cell.text||<span class="empty-cell" aria-label="未排班">—</span>}</td>)}</tr>)}</tbody></table></div><div class="schedule-mobile"><nav class="duty-tabs" aria-label="選擇星期">{days.map((day,i)=><a href={`#day-${i+1}`} data-day-col={i+1}>{day.replace('星期','週')}</a>)}</nav><div class="duty-track">{days.map((day,i)=><section class="duty-day" id={`day-${i+1}`} aria-label={day}><dl>{schedule.rows.map((row:any[])=><div><dt>{row[0].text}</dt><dd>{row[i+1].members.length?row[i+1].members.map((person:any)=><a href={withBase(person.href)}>{person.name}</a>):row[i+1].text||<span class="empty-cell">未排班</span>}</dd></div>)}</dl></section>)}</div></div><div class="schedule-help"><p>如果你到訪時暫時沒有人，請先留下問題與聯絡方式，我們會於辦公時段協助。</p><a class="button" href={`mailto:${s.email}`}>聯絡機房<span aria-hidden="true">↗</span></a></div></div><script>
  // Phones: one weekday per panel; swipe or tap a tab, starting on today (Taipei time).
  const track = document.querySelector<HTMLElement>('.duty-track')!;
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.duty-tabs a')];
  const today = new Date().toLocaleDateString('en-US', { timeZone: 'Asia/Taipei', weekday: 'short' });
  const initial = ({ Mon: 0, Tue: 1, Wed: 2, Thu: 3, Fri: 4 } as Record<string, number>)[today] ?? 0;
  const mark = (index: number) => tabs.forEach((tab, i) => tab.setAttribute('aria-current', String(i === index)));
  const show = (index: number, behavior: ScrollBehavior) => { track.scrollTo({ left: index * track.clientWidth, behavior }); mark(index); };
  track.addEventListener('scroll', () => { if (track.clientWidth) mark(Math.round(track.scrollLeft / track.clientWidth)); }, { passive: true });
  tabs.forEach((tab, i) => tab.addEventListener('click', event => { event.preventDefault(); show(i, 'smooth'); }));
  mark(initial);
  if (track.clientWidth) show(initial, 'instant');
</script></Layout>
