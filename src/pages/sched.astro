---
import Layout from '../layouts/Layout.astro';
import { getSettings, getSchedule } from '../lib/content.mjs';
import { withBase } from '../lib/paths.mjs';
const s=getSettings();const schedule=getSchedule();
const days=['星期一','星期二','星期三','星期四','星期五'];
---
<Layout title="機房值班表"><header class="page-intro wrap"><h1>來 213，<br />找值班的我們。</h1><p>{s.officeHours} · {s.phone}<br />班表更新於 {schedule.updated}，實際值班可能依課程與學期調整。</p></header><div class="page-content wrap"><div class="schedule-desktop"><table class="duty-table"><caption>工程二館網路機房值班表</caption><thead><tr><th scope="col">時間</th>{days.map(day=><th scope="col">{day}</th>)}</tr></thead><tbody>{schedule.rows.map((row:any[])=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell.text}</th>:<td>{cell.members.length?cell.members.map((person:any)=><a href={withBase(person.href)}>{person.name}</a>):cell.text||<span class="empty-cell" aria-label="未排班">—</span>}</td>)}</tr>)}</tbody></table></div><div class="schedule-mobile"><label for="duty-day">選擇星期</label><select id="duty-day">{days.map((day,i)=><option value={i+1}>{day}</option>)}</select>{days.map((day,i)=><section class="duty-day" data-day={i+1}><h2>{day}</h2><dl>{schedule.rows.map((row:any[])=><div><dt>{row[0].text}</dt><dd>{row[i+1].members.length?row[i+1].members.map((person:any)=><a href={withBase(person.href)}>{person.name}</a>):row[i+1].text||'未排班'}</dd></div>)}</dl></section>)}</div><div class="schedule-help"><p>如果你到訪時暫時沒有人，請先留下問題與聯絡方式，我們會於辦公時段協助。</p><a class="button" href={`mailto:${s.email}`}>聯絡機房<span aria-hidden="true">↗</span></a></div></div><script>const select=document.querySelector<HTMLSelectElement>('#duty-day')!;const days=[...document.querySelectorAll<HTMLElement>('.duty-day')];const today=new Date().toLocaleDateString('en-US',{timeZone:'Asia/Taipei',weekday:'short'});const initial={Mon:1,Tue:2,Wed:3,Thu:4,Fri:5}[today as 'Mon']||1;select.value=String(initial);function update(){days.forEach(day=>{day.hidden=day.dataset.day!==select.value})}select.addEventListener('change',update);update();</script></Layout>
