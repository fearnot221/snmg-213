---
import { withBase } from '../lib/paths.mjs';
import Layout from '../layouts/Layout.astro';
import { documents } from '../lib/seed.mjs';
---
<Layout title="文件下載"><header class="page-intro wrap"><h1>少一點摸索，<br />多一點上手。</h1><p>郵件與無線網路的操作文件，沿用原站下載連結。</p></header><div class="page-content wrap support-list">{documents.map(doc => <section class="support-item"><h2>{doc.title}</h2><div><p>{doc.summary}</p><a class="button" href={doc.url} target="_blank" rel="noopener noreferrer">開啟教學文件<span aria-hidden="true">↗</span></a></div></section>)}<a class="text-link" href={withBase("/announcements?category=教學文件")}>瀏覽所有教學文章 ↗</a></div></Layout>
