---
import { withBase } from '../../lib/paths.mjs';
import Layout from '../../layouts/Layout.astro';
import { getPosts, renderMarkdown, formatDate } from '../../lib/content.mjs';
export function getStaticPaths() {
  return getPosts().map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<Layout title={post.title} description={post.summary}><header class="page-intro wrap"><a class="back-link" href={withBase("/announcements")}>← 公告與文章</a><h1 class="article-title">{post.title}</h1></header><article class="page-content wrap article-layout"><aside class="article-sidebar"><div><strong>{post.category}</strong>{post.pinned ? '置頂文章' : '工程二館網路機房'}</div><div><strong>{post.source ? '匯入日期' : '發布日期'}</strong><time datetime={post.date}>{formatDate(post.date)}</time></div><a class="text-link" href={withBase("/announcements")}>返回文章列表</a></aside><div>{post.source && <div class="source-note">這是原站文章的整理摘要，維護時段或活動可能已結束。<br /><a class="text-link" href={post.source} target="_blank" rel="noopener noreferrer">閱讀原站完整文章 ↗</a></div>}<div class="prose" set:html={renderMarkdown(post.body)}></div></div></article></Layout>
<style>.article-title{font-size:clamp(36px,4.5vw,68px)!important;max-width:1100px!important}@media(max-width:600px){.article-title{font-size:32px!important}}</style>
