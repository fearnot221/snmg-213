---
import { withBase } from '../lib/paths.mjs';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { getSettings } from '../lib/content.mjs';
interface Props { title?: string; description?: string; }
const { title, description = '國立中央大學工程二館網路機房。網路維運、DNS 申請、系所郵件、網頁代管與網管培訓。' } = Astro.props;
const settings = getSettings();
const path = Astro.url.pathname;
const navigation = [{ href: '/#services', label: '網路服務' }, { href: '/announcements/', label: '公告與文章' }, { href: '/about/', label: '關於機房' }, { href: '/joinus/', label: '加入我們' }];
const resources=[{href:'/documents/',label:'文件與教學'},{href:'/sched/',label:'機房值班表'},{href:'/members/',label:'團隊成員'},{href:'/pages/',label:'完整網站索引'}];
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <slot name="head" />
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0b" />
    <title>{title ? `${title} — SNMG 工二機房` : 'SNMG 工二機房 — 連結校園，不只網路'}</title>
    <meta name="description" content={description} /><link rel="canonical" href={canonical} />
    <meta property="og:title" content={title || 'SNMG 工二機房 — 連結校園，不只網路'} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="zh_TW" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/images/social.svg'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400..700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;900&display=swap" rel="stylesheet" />
    <script is:inline>
      // Motion styles only apply once we know motion is welcome; the boot sequence plays once per visit.
      (function(){var d=document.documentElement;if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;d.classList.add('js-motion');try{if(!sessionStorage.getItem('snmg-boot')){d.classList.add('booting');sessionStorage.setItem('snmg-boot','1')}}catch(e){}setTimeout(function(){if(!d.dataset.motion)d.classList.remove('js-motion','booting')},4000)})();
    </script>
  </head>
  <body>
    <div class="boot" aria-hidden="true">
      <div class="boot-lines"><p><span>SYN</span><span>→ E1-213</span></p><p><span>SYN-ACK</span><span>← E1-213</span></p><p><span>ACK</span><span>已連線</span></p></div>
      <div class="boot-mark"><Mark large /></div>
    </div>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase("/")} aria-label="SNMG 工二機房首頁"><Mark /><span class="brand-name">snmg<span class="brand-caption">中央大學 工二機房</span></span></a>
        <nav class="desktop-nav" aria-label="主要導覽">{navigation.map(link => <a href={withBase(link.href)} aria-current={path === withBase(link.href) ? 'page' : undefined}>{link.label}</a>)}<details class="resource-menu"><summary>更多資源 <span aria-hidden="true">＋</span></summary><nav aria-label="資源導覽">{resources.map(link=><a href={withBase(link.href)}>{link.label}</a>)}</nav></details><i class="nav-dot" aria-hidden="true"></i></nav>
        <a class="header-action" href={withBase("/forms/")}>服務與支援</a>
        <details class="mobile-menu"><summary aria-label="開啟導覽選單"><span class="burger" aria-hidden="true"><i></i><i></i></span>選單</summary><nav aria-label="手機導覽">{navigation.map(link => <a href={withBase(link.href)}>{link.label}</a>)}<a href={withBase("/forms/")}>服務與支援</a>{resources.map(link=><a href={withBase(link.href)}>{link.label}</a>)}</nav></details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-unit">
        <div class="footer-brand"><a href={withBase("/")} class="brand"><Mark /><span class="brand-name">snmg</span></a><p>國立中央大學<br />工程二館網路機房</p></div>
        <nav class="footer-nav" aria-label="頁尾導覽">
          <div><h2>服務</h2><a href={withBase("/forms/")}>服務與支援</a><a href={withBase("/documents/")}>文件與教學</a><a href={withBase("/sched/")}>機房值班表</a><a href={withBase("/announcements/")}>公告與文章</a></div>
          <div><h2>團隊</h2><a href={withBase("/about/")}>關於機房</a><a href={withBase("/members/")}>團隊成員</a><a href={withBase("/joinus/")}>加入我們</a><a href={withBase("/pages/")}>網站索引</a></div>
          <div><h2>相關連結</h2><a href="https://www.ce.ncu.edu.tw/" target="_blank" rel="noopener noreferrer">通訊系 ↗</a><a href="https://www2.ee.ncu.edu.tw/" target="_blank" rel="noopener noreferrer">電機系 ↗</a><a href={withBase("/admin/")}>管理後台</a></div>
        </nav>
        <div class="footer-status">
          <div class="status-row"><span>台北時間</span><span data-clock>--:--</span></div>
          <div class="status-row"><span>{settings.officeHours}</span><span data-office>辦公時間</span></div>
          <a href={`mailto:${settings.email}`}>{settings.email}</a>
          <span>{settings.phone}</span>
          <a href="https://maps.app.goo.gl/yUiPDJRYHmtqZB7z8" target="_blank" rel="noopener noreferrer">工程二館 E1-213 室 ↗</a>
        </div>
      </div>
      <div class="wrap footer-panel" aria-hidden="true"><span>E1-213</span><div class="ports">{Array.from({ length: 24 }, () => <i></i>)}</div><span>SNMG</span></div>
      <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} NCU EECE SNMG</span><span>讓好奇心，保持連線。</span><a href="#main">回到頂端 ↑</a></div>
    </footer>
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
